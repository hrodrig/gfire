# syntax=docker/dockerfile:1
# Runtime image for GoReleaser dockers_v2: binaries are built by GoReleaser and laid out as
# linux/<arch>/<binary> in the build context.
# Local multi-stage compile: use Dockerfile (make docker-build).
ARG TARGETPLATFORM
FROM gcr.io/distroless/static-debian13:nonroot
ARG TARGETPLATFORM
WORKDIR /app
LABEL org.opencontainers.image.title="gfire"
LABEL org.opencontainers.image.description="Standalone background job service"
LABEL org.opencontainers.image.source="https://github.com/hrodrig/gfire"
LABEL org.opencontainers.image.authors="https://github.com/hrodrig/gfire"
COPY ${TARGETPLATFORM}/gfire /app/gfire
USER nonroot:nonroot
ENTRYPOINT ["/app/gfire"]
CMD ["version"]
